# Copy to .env and fill in local values. Loaded by src/main.py via
# python-dotenv; every variable is optional and falls back to the default in
# src/config.py.

# Service port — use 8083 locally (8080 is taken by keep-api-gateway)
KEEP_AUTOMATION_API_PORT=8083

# Auth mode for user-tier routes; only "noauth" is wired in the skeleton
AUTH_TYPE=noauth

# Shared platform Postgres DSN (SQLAlchemy form) — the `keep` database, same
# instance the gateway and event-handler use. Locally: the keepHQ docker compose
# stack on 5432. There is no separate `automations` database.
DATABASE_URL=postgresql://keep:keep@localhost:5432/keep

# Machine-tier: GitLab CI webhook secret token (A0)
CI_WEBHOOK_TOKEN=

# Internal-tier: service token for consumer/reconciler calls (A0)
INTERNAL_SERVICE_TOKEN=

# Comma-separated trusted browser origins
KEEP_CORS_TRUSTED_ORIGINS=*
