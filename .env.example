# Copy to .env and fill in local values. Loaded by src/main.py and
# migrations/env.py via python-dotenv; every variable is optional and falls
# back to the default in src/config.py.

# Service port — use 8083 locally (8080 is taken by keep-api-gateway)
KEEP_AUTOMATION_API_PORT=8083

# Auth mode for user-tier routes; only "noauth" is wired in the skeleton
AUTH_TYPE=noauth

# Control-plane Postgres DSN (SQLAlchemy form). A0 provisions real instances;
# locally use the keepHQ docker compose stack.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5434/keep_automations

# Machine-tier: GitLab CI webhook secret token (A0)
CI_WEBHOOK_TOKEN=

# Internal-tier: service token for consumer/reconciler calls (A0)
INTERNAL_SERVICE_TOKEN=

# Comma-separated trusted browser origins
KEEP_CORS_TRUSTED_ORIGINS=*
